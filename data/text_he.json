    "hint_need_trap":      "\ud83e\udea4 \u05de\u05dc\u05db\u05d5\u05d3\u05ea \u05d3\u05d2\u05d9\u05dd \u05de\u05d7\u05db\u05d4 \u05de\u05ea\u05d7\u05ea \u05dc\u05e9\u05d5\u05e9\u05e0\u05d5\u05ea \u05d4\u05de\u05d9\u05dd \u05d4\u05e2\u05e0\u05e7\u05d9\u05d5\u05ea \u05d1\u05e0\u05d4\u05e8...",
    "hint_need_rope":      "\ud83e\udea2 \u05e6\u05e8\u05d9\u05da \u05d7\u05d1\u05dc \u05d2\u05e4\u05e0\u05d9\u05dd! \u05e7\u05dc\u05d5\u05e2 \u05d0\u05d7\u05d3 \u05de\u05d2\u05e4\u05e0\u05d9\u05dd \u05d1\u05d2'\u05d5\u05e0\u05d2\u05dc \u05d4\u05e6\u05e4\u05d5\u05e3...",
    "hint_need_explorer_1": "\ud83d\udd0d \u05e6\u05e8\u05d9\u05da \u05e8\u05de\u05ea \u05e1\u05d9\u05d9\u05e8\u05ea 1! \u05e9\u05d3\u05e8\u05d2\u05d9 \u05d1\u05d9\u05d5\u05de\u05df \u05d4\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d1\u05de\u05d7\u05e0\u05d4...",
    "hint_need_explorer_2": "\ud83c\udf33 \u05e6\u05e8\u05d9\u05da \u05e8\u05de\u05ea \u05e1\u05d9\u05d9\u05e8\u05ea 2! \u05e2\u05d5\u05d3 \u05e7\u05e6\u05ea \u05d0\u05d9\u05de\u05d5\u05df \u05d5\u05ea\u05d8\u05e4\u05e1 \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8!",
    "hint_need_explorer_3": "\ud83d\udc06 \u05e6\u05e8\u05d9\u05da \u05e8\u05de\u05ea \u05e1\u05d9\u05d9\u05e8\u05ea 3! \u05e8\u05e7 \u05e1\u05d9\u05d9\u05e8\u05ea \u05de\u05d5\u05de\u05d7\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05de\u05e6\u05d5\u05d0 \u05d9\u05d2\u05d5\u05d0\u05e8...",
    "hint_need_nature_1":  "\ud83c\udf3f \u05e6\u05e8\u05d9\u05da \u05e8\u05de\u05ea \u05d9\u05d3\u05d9\u05d3\u05ea \u05d4\u05d8\u05d1\u05e2 1! \u05dc\u05de\u05d3\u05d9 \u05dc\u05d6\u05d4\u05d5\u05ea \u05e6\u05de\u05d7\u05d9 \u05de\u05e8\u05e4\u05d0 \u05d1\u05d9\u05d5\u05de\u05df \u05d4\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea...",
    "hint_need_nature_2":  "\ud83d\udc12 \u05e6\u05e8\u05d9\u05da \u05e8\u05de\u05ea \u05d9\u05d3\u05d9\u05d3\u05ea \u05d4\u05d8\u05d1\u05e2 2! \u05d4\u05d7\u05d9\u05d5\u05ea \u05e6\u05e8\u05d9\u05db\u05d5\u05ea \u05dc\u05d1\u05d8\u05d5\u05d7 \u05d1\u05da \u05d9\u05d5\u05ea\u05e8...",
    "hint_need_survival_1": "\ud83d\udd25 \u05e6\u05e8\u05d9\u05da \u05e8\u05de\u05ea \u05e9\u05d5\u05e8\u05d3\u05ea 1! \u05dc\u05de\u05d3\u05d9 \u05dc\u05d1\u05e9\u05dc \u05d0\u05e8\u05d5\u05d7\u05d4 \u05e9\u05dc\u05de\u05d4 \u05d1\u05d9\u05d5\u05de\u05df \u05d4\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea...",
    "hint_need_survival_2": "\ud83e\udea2 \u05e6\u05e8\u05d9\u05da \u05e8\u05de\u05ea \u05e9\u05d5\u05e8\u05d3\u05ea 2! \u05e2\u05d5\u05d3 \u05e7\u05e6\u05ea \u05d0\u05d9\u05de\u05d5\u05df \u05dc\u05e7\u05dc\u05d5\u05e2 \u05d7\u05d1\u05dc...",
    "hint_need_survival_3": "\ud83c\udfa3 \u05e6\u05e8\u05d9\u05da \u05e8\u05de\u05ea \u05e9\u05d5\u05e8\u05d3\u05ea 3! \u05e8\u05e7 \u05e9\u05d5\u05e8\u05d3 \u05de\u05d5\u05de\u05d7\u05d4 \u05d9\u05d5\u05d3\u05e2 \u05dc\u05d1\u05e0\u05d5\u05ea \u05de\u05dc\u05db\u05d5\u05d3\u05ea \u05e1\u05e4\u05d5\u05e0\u05d8\u05e0\u05d9\u05ea..."
  },
